<%- include('includes/_header.ejs') %>

<a href="/inicio/jugadores/actuales"><button class="button is-danger">Regresar</button></a>
<br><br>
<h2 class="title is-4">Editar Jugador</h2>
<form action="/jugadores/editar" method="POST" enctype="multipart/form-data">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="id" value="<%= jugador.id %>">
  <input type="hidden" name="imagen_vieja" value="<%= jugador.imagen %>">

  <div class="field">
    <label for="nombre" class="label">Nombre</label>
    <div class="control">
      <input id="nombre" name="nombre" class="input" type="text" value="<%= jugador.nombre %>">
    </div>
  </div>
  <div class="field">
    <label for="id_posicion" class="label">Posición</label>
    <div class="control">
      <div class="select">
        <select id="id_posicion" name="id_posicion">
          <% for (let posicion of posiciones) { %>
            <option value="<%= posicion.id %>" <%= posicion.id === jugador.id_posicion ? 'selected' : '' %>><%= posicion.nombre %></option>
          <% } %>
        </select>
      </div>
    </div>
  </div>
  <div class="field">
    <label for="archivo" class="label">Imagen</label>
    <div class="control">
      <input id="archivo" name="archivo" class="input" type="file">
    </div>
  </div>
  <input class="button is-danger" type="submit" value="Guardar cambios">
</form>

<%- include('includes/_footer.ejs') %>