<%- include('includes/_header.ejs') %>

<a href="/inicio/jugadores/actuales"><button class="button is-danger">Regresar</button></a>
<br><br>
<form action="/jugadores/nuevo" method="POST" enctype="multipart/form-data">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="field">
    <label for="nombre" class="label">Nombre</label>
    <div class="control">
      <input id="nombre" name="nombre" class="input" type="text" placeholder="e.g. Chicharito">
    </div>
  </div>
  <div class="field">
    <label for="id_posicion" class="label">Posición</label>
    <div class="control">
      <div class="select">
        <select id="id_posicion" name="id_posicion">
          <% for (let posicion of posiciones) { %>
            <option value="<%= posicion.id %>"><%= posicion.nombre %></option>
          <% } %>
        </select>
      </div>
    </div>
  </div>
  <div class="field">
    <label for="archivo" class="label">Imagen</label>
    <div class="control">
      <input id="archivo" name="archivo" class="input" type="file">
    </div>
  </div>
  <input class="button is-danger" type="submit" value="Guardar">
</form>

<%- include('includes/_footer.ejs') %>